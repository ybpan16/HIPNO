# HIPNO public-repository exclusions
#
# This repository tracks source code, configuration templates, documentation,
# manifests, and audited aggregate paper tables. It does not track raw or
# row-level clinical data, waveform shards, trained weights, or local run data.

# Operating-system and editor files
.DS_Store
.Rhistory
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Python build, test, and notebook state
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# Local environments, credentials, and private configuration
.venv/
venv/
env/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.*
.netrc

# Cluster and experiment runtime state
/runs/
/logs/
/cache/
/scratch/
/tmp/
/server_environment/
/local_records/
/paper/private/
slurm-*.out
slurm-*.err
*.log
core.*

